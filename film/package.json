{
  "name": "veyra-heist-film",
  "private": true,
  "description": "VEYRA HEIST: the launch film. Remotion + Three.js; the score is synthesized by audio/score.py.",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "score": "python3 audio/score.py",
    "render": "remotion render src/index.ts VeyraHeist out/veyra-heist-silent.mp4 --gl=swangle --concurrency=4",
    "still": "remotion still src/index.ts VeyraHeist out/cover.png --gl=swangle"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@react-three/fiber": "^9.8.2",
    "@remotion/cli": "^4.0.543",
    "@remotion/three": "^4.0.543",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "^4.0.543",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/three": "^0.187.0",
    "typescript": "^5.9.3"
  }
}
