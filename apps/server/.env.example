# Veyra backend configuration. In production these come from your secret manager.
# Nothing here is needed for the simulator: `pnpm demo` and VEYRA_MODE=sim run with zero config.

# sim = local Agent Market simulator, in-memory NEAR ledger, play money
# live = market.near.ai + NEAR mainnet (real USDC)
VEYRA_MODE=sim
PORT=8787
PUBLIC_WEB_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/veyra.db

# 32 bytes (64 hex). Seals the spend-account keys, grant tokens, OAuth tokens and receipt key.
# REQUIRED in production. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VEYRA_ENCRYPTION_KEY=

# Share of each contract kept as margin (bps)
CONTRACT_MARGIN_BPS=2000

# ---- Agent Market (live) -------------------------------------------------------------
MARKET_ORIGIN=https://market.near.ai
# aat_ work token of Veyra's own listing (Building -> your agent -> API tokens). Needed to earn.
MARKET_WORKER_TOKEN=
# Optional: webhook secret (>= 32 chars) registered on the listing; endpoint POST /webhooks/market
MARKET_WEBHOOK_SECRET=

# ---- Spend account: signs x402 cheques (USDC on NEAR mainnet) ----------------------
# Leave empty to generate an implicit account (fund it with a little NEAR for gas and
# register it on the USDC contract). Or import a dedicated account:
SPEND_ACCOUNT_ID=
SPEND_ACCOUNT_KEY=
SPEND_KEY_POOL=4
MAX_FLOAT_USDC=5
# Margin above the float is paid to the owner once it reaches this many USDC (0 disables)
PAYOUT_MIN_USDC=1
# Selling over x402: smallest job Veyra accepts, and its SLA (a buyer's cheque must stay valid for SLA + 10 min)
SELLER_MIN_USDC=1
SELLER_SLA_SECONDS=3600

# ---- Policy vault: NEAR Intents Agent API ---------------------------------------------
# Partner key (production: partners.near-intents.org; demo: partners.demo.agentsonintents.com)
NEAR_INTENTS_AGENT_API_KEY=
NEAR_INTENTS_AGENT_API_URL=https://api.agentsonintents.com
# Agent id created in Settings -> Vault (owner-signed in your wallet)
VAULT_AGENT_ID=
NEAR_NETWORK=mainnet

# ---- Receipt anchoring and threat reports (veyra-ledger contract) ----------------------
# Used in the simulator too, so a hosted demo writes real anchors to testnet for free.
# Deploy your own with `pnpm deploy:ledger` (see docs), or leave empty for the simulated chain.
LEDGER_CONTRACT_ID=
LEDGER_NETWORK=testnet
# In the simulator, audit the real market.near.ai (read-only) instead of the simulated one
WATCHTOWER_LIVE=false
# Writer when the ledger is on a different network than the spend account
LEDGER_WRITER_ID=
LEDGER_WRITER_KEY=

# ---- NEAR AI Cloud (private, TEE-attested planning and judging) ------------------------
NEAR_AI_API_KEY=
NEAR_AI_MODEL=z-ai/glm-5.3-flash
NEAR_AI_REQUIRE_SIGNATURE=true

# ---- Veyra Heist (the game) -----------------------------------------------------------
# The pot contract and its network. Ranked runs need the referee key: the account the contract
# lets call `resolve` (defaults to LEDGER_WRITER_ID / LEDGER_WRITER_KEY).
HEIST_CONTRACT_ID=
# NEP-245 loot contract (pnpm deploy:loot). The referee mints gold bars to ranked winners.
LOOT_CONTRACT_ID=
HEIST_NETWORK=testnet
HEIST_REFEREE_ID=
HEIST_REFEREE_KEY=
HEIST_RATE_PER_MIN=30
