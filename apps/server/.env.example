# Veyra backend configuration. In production these come from your secret manager.
# Never put any of these in a frontend environment file.

PORT=8787
PUBLIC_WEB_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/veyra.db
EVIDENCE_DIR=./data/evidence

# 32 bytes (64 hex chars). Encrypts grant tokens at rest. REQUIRED in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VEYRA_ENCRYPTION_KEY=
VEYRA_AUTH_RECIPIENT=veyra.app

# NEAR Intents Agent API (experimental, MAINNET-ONLY beta, real funds).
# Partner key from https://partners.near-intents.org/ — backend only.
NEAR_INTENTS_AGENT_API_KEY=
NEAR_INTENTS_AGENT_API_URL=https://api.agentsonintents.com
AGENT_GRANT_TTL_DAYS=30

# NEAR Intents 1Click (manual swaps). Optional JWT removes 1Click's default fee.
ONECLICK_API_URL=https://1click.chaindefuser.com
ONECLICK_JWT=

# Network for wallet login and Veyra's own contracts
NEAR_NETWORK=testnet
# NEAR_RPC_URL=https://rpc.testnet.near.org
ESCROW_CONTRACT_ID=
REWARDS_CONTRACT_ID=
# Mainnet escrow the agent may fund (the Agent API runs on mainnet only)
AGENT_ESCROW_CONTRACT_ID=

# NEAR AI Cloud (private, TEE-attested inference). Without it a labelled deterministic planner runs.
NEAR_AI_API_KEY=
NEAR_AI_MODEL=z-ai/glm-5.3-flash
NEAR_AI_REQUIRE_SIGNATURE=true

# Optional ordinary OpenAI-compatible provider, used ONLY for non-sensitive tasks
STANDARD_AI_API_KEY=
STANDARD_AI_BASE_URL=
STANDARD_AI_MODEL=

# Chain Signatures (defaults: v1.signer-prod.testnet / v1.signer)
# CHAIN_SIGNATURES_CONTRACT_ID=
EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
EVM_CHAIN_ID=11155111

# Seed clearly-labelled demo providers (their offers are simulated)
SEED_DEMO_PROVIDERS=1
