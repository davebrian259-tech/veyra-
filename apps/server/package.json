{
  "name": "@veyra/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "tsx src/cli/demo.ts",
    "live:dry-run": "tsx --env-file-if-exists=.env src/cli/live-dry-run.ts",
    "watchtower": "tsx src/cli/watchtower.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@near-intents-agent-api/sdk": "0.8.2",
    "@near-js/crypto": "2.5.1",
    "@near-js/transactions": "2.5.1",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@phala/dcap-qvl": "0.7.1",
    "@scure/base": "^2.4.0",
    "borsh": "1.0.0",
    "fastify": "^5.12.8",
    "viem": "^2.57.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
